{
  "expo": {
    "name": "EliteFitness",
    "slug": "marcelo-herrera-trainer-app",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#00030D",
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.trainermarcelo.app",
      "buildNumber": "1",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.trainermarcelo.app",
      "adaptiveIcon": {
        "backgroundColor": "#00030D",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-video",
      "expo-font",
      [
        "expo-image-picker",
        {
          "photosPermission": "La app necesita acceso a tus fotos para subir imágenes de ejercicios, avatares y fotos de progreso."
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "backgroundColor": "#00030D",
          "imageWidth": 200
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#D8D9D7"
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "La app usa el micrófono para grabar notas de voz en el chat con tu entrenador."
        }
      ],
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "Usa Face ID para desbloquear la app en vez de escribir tu contraseña cada vez."
        }
      ],
      "expo-asset",
      "@sentry/react-native"
    ],
    "extra": {
      "eas": {
        "projectId": "4ec491f8-d9e0-434f-8ee1-828f27bb57f4"
      }
    },
    "owner": "hizocars-team"
  }
}
